# Copier en `.env` (ou passer en variables d'environnement au conteneur).
# Aucune de ces valeurs n'est dans le dépôt : il est public.

PORT=3000
# Dossier de la base SQLite et de reglages.json (un volume Docker en production).
DONNEES=./donnees
# L'adresse publique du module, sans barre finale.
URL_PUBLIQUE=https://rdv.exemple.re
# Les sites autorisés à appeler l'API depuis un navigateur, séparés par des virgules.
SITE_ORIGINES=https://exemple.re,https://www.exemple.re

PROPRIETAIRE_NOM=Prénom
PROPRIETAIRE_EMAIL=prenom@exemple.re
PROPRIETAIRE_TELEPHONE=

# Google Cloud → API Calendar activée → client OAuth « application Web »
# avec l'URI de redirection URL_PUBLIQUE/google/retour, écran de consentement
# en statut « In production » (sinon le jeton expire au bout de 7 jours).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# L'ADRESSE du compte Google, pas « primary » : avec le seul accès freebusy,
# Google répond notFound pour l'alias « primary ».
GOOGLE_CALENDRIER=prenom@exemple.re

# SMTP authentifié de la boîte du propriétaire. Port 465 = TLS implicite.
SMTP_HOTE=smtp.exemple.re
SMTP_PORT=465
SMTP_UTILISATEUR=prenom@exemple.re
SMTP_MOT_DE_PASSE=
SMTP_EXPEDITEUR="Prénom <prenom@exemple.re>"

# Protège /google/connexion et sale le hachage des adresses IP. Longue et aléatoire.
CLE_ADMIN=
